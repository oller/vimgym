{
  "name": "vimsplain",
  "version": "0.3.2",
  "description": "Parse and explain Vim keystroke sequences",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "gen:commands": "tsx scripts/gen-commands-table.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutate": "stryker run",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset"
  },
  "keywords": [
    "vim",
    "vim-motions",
    "vim-commands",
    "explainer",
    "parser",
    "education"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oller/vimgym.git",
    "directory": "packages/vimsplain"
  },
  "homepage": "https://github.com/oller/vimgym/tree/main/packages/vimsplain#readme",
  "bugs": "https://github.com/oller/vimgym/issues",
  "publishConfig": {
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@replit/codemirror-vim": "^6.4.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  }
}
