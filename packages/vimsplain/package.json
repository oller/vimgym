{
  "name": "vimsplain",
  "version": "0.1.5",
  "description": "Parse and explain Vim keystroke sequences",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "gen:commands": "tsx scripts/gen-commands-table.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset"
  },
  "keywords": [
    "vim",
    "vim-motions",
    "vim-commands",
    "explainer",
    "parser",
    "education"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oller/vimgym.git",
    "directory": "packages/vimsplain"
  },
  "homepage": "https://github.com/oller/vimgym/tree/main/packages/vimsplain#readme",
  "bugs": "https://github.com/oller/vimgym/issues",
  "publishConfig": {
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "tsdown": "^0.21.2",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  }
}
