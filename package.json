{
  "name": "vimgym",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "tsc": "tsc -b",
    "types:gen": "supabase gen types typescript --project-id npgygqytvyudcqzntvvo > src/types/database.ts",
    "types:sync": "pnpm types:gen && pnpm tsc",
    "postinstall": "lefthook install",
    "deploy": "pnpm --filter vimsplain build && pnpm types:sync && pnpm lint && pnpm test:run && pnpm build",
    "test:mutate:vimsplain": "pnpm --filter vimsplain test:mutate",
    "knip": "knip"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@replit/codemirror-vim": "^6.4.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "@uiw/codemirror-theme-tokyo-night-storm": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@varlock/vite-integration": "^1.5.3",
    "clsx": "^2.1.1",
    "motion": "^14.1.0",
    "nuqs": "^2.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "varlock": "^1.22.0",
    "vimsplain": "workspace:*",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "supabase": "^2.120.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "esm-env": "npm:esm-env-runtime@^0.1.1"
    },
    "onlyBuiltDependencies": [
      "supabase",
      "lefthook"
    ]
  }
}
